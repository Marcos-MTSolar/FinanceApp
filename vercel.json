{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.tsx": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "node_modules/@react-pdf/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.tsx" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
